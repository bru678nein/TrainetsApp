# Copiar a .env y completar. .env nunca se commitea.
# Puerto 5433: el compose publica ahí para no chocar con un Postgres nativo
# que ya esté escuchando en 5432.
DATABASE_URL=postgresql+psycopg://coach:coach@localhost:5433/coachapp

# Base de tests. Tiene que terminar en '_test': la suite borra el esquema antes
# de migrar y conftest.py se niega a correr contra cualquier otro nombre.
TEST_DATABASE_URL=postgresql+psycopg://coach:coach@localhost:5433/coachapp_test

ENVIRONMENT=development
LOG_LEVEL=INFO

# Auth. Las tres son obligatorias: la app se niega a arrancar sin ellas.
# El `iss` que emite el proveedor. Para una instancia de desarrollo de Clerk es
# su Frontend API, sin barra al final:
AUTH_ISSUER=https://tu-instancia.clerk.accounts.dev

# El origen del frontend. Se compara contra el claim `azp`, NO contra `aud`, y
# además es el único origen que CORS habilita — son el mismo dato con dos usos.
#
# Desincronizado del puerto real del frontend falla dos veces y ninguna lo dice:
# el preflight `OPTIONS` vuelve 400 porque el origen no está permitido, y si
# pasara, el token sería rechazado por `azp`. En desarrollo, Vite escucha acá:
AUTH_AUTHORIZED_PARTY=http://localhost:5173
# El mismo host, con el sufijo estándar. Que apunte a un host inexistente no se
# nota al arrancar —la app sólo exige que la variable esté— y aparece recién en
# el primer request autenticado, como un 503 en todo. Se comprueba con:
#
#   curl -s -o /dev/null -w '%{http_code}
' "$AUTH_JWKS_URL"
AUTH_JWKS_URL=https://tu-instancia.clerk.accounts.dev/.well-known/jwks.json
