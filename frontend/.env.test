# Valores de mentira para que los tests corran en un clon limpio y en CI, donde
# no hay `.env`. Vite carga este archivo cuando el modo es `test`, que es el que
# usa Vitest.
#
# Se versiona a propósito, al revés que `.env`: acá no hay nada que proteger y lo
# que se gana es que la suite no dependa de un archivo que no existe. Sin esto,
# los tests pasan en la máquina de quien los escribió y fallan en todas las demás
# — que es exactamente cómo se descubrió.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_de-mentira-para-los-tests
VITE_API_URL=http://api.de-mentira.test
