# La clave publicable de Clerk. Viaja en el bundle y es pública por diseño: no es
# un secreto y no hay forma de ocultarla en una aplicación de navegador.
#
# Aun así no se versiona la real. Un clon del repositorio no tiene por qué entrar
# a la instancia de Clerk de otra persona, y el día que este proyecto tenga una
# instancia de producción, la de desarrollo dejada en el historial es una puerta
# que nadie recuerda haber abierto.
#
# Se saca del panel de Clerk, en API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Dónde escucha el backend. En desarrollo es otro origen que el frontend, y por
# eso existe CORS: el navegador trata :8000 y :5173 como sitios distintos.
VITE_API_URL=http://localhost:8000
